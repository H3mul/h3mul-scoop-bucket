{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^bucket/element\\.json$/"
      ],
      "matchStrings": [
        "\"version\": \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "kushview/element",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^bucket/cate\\.json$/"
      ],
      "matchStrings": [
        "\"version\": \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "0-AI-UG/cate",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "loose"
    }
  ]
}
